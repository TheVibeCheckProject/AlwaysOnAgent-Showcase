# ============================================================================
# AlwaysOnAgent Configuration (.env.example)
# Copy this file to .env and replace placeholders with your credentials.
# .env is git-ignored; never commit real keys.
# ============================================================================

# ----------------------------------------------------------------------------
# Cloud AI (all free tiers, no card needed; see docs/AI_MODELS.md)
# ----------------------------------------------------------------------------
# The model ORDER is not set here: it lives in core/llm/__init__.py (CloudLLM.CHAT_MODELS, BACKGROUND_MODELS,
# TASK_MODELS) and docs/AI_HANDOFF.md section 3. A provider without a key below is simply skipped.
#
# Google Gemini (first choice): chat starts on gemini-3.5-flash-lite, then the Flash models, 3.1 Flash-Lite
# and Gemma 4 26B; background chores use 3.5 Flash-Lite, then Gemma 4 26B. Free tier only, no billing.
# GOOGLE_API_KEY is accepted as an alias.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq: fallback for chat, chores and tasks (gpt-oss-120b, qwen3.8-27b, gpt-oss-20b).
# Very fast, with prompt caching.
# Get a free key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Cloudflare Workers AI fallback (gpt-oss-120b / 20b). Both values are needed.
# Dashboard > Workers AI > "Use REST API" provides both values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Mistral free "Experiment" plan (Codestral for coding, ministral-14b fallback).
# Turn off training first: admin.mistral.ai > Privacy > "Anonymous improvement data".
MISTRAL_API_KEY=

# ----------------------------------------------------------------------------
# Mobile App & HUD API (DeskAI)
# ----------------------------------------------------------------------------
# HUD server bind host and port (default 0.0.0.0:8080)
HUD_HOST=0.0.0.0
HUD_PORT=8080

# API authentication token (required for non-localhost / mobile app connections).
# Generate one with: python -c "import secrets; print(secrets.token_hex(24))"
# Enter this token in DeskAI connection settings alongside host/Tailscale IP.
HUD_AUTH_TOKEN=your_secure_random_token_here

# Firebase Cloud Messaging (FCM) push notifications
# Path to the Firebase service account JSON key for sending push notifications to DeskAI.
# Default: data/secrets/fcm-service-account.json
FCM_SERVICE_ACCOUNT=data/secrets/fcm-service-account.json

# ----------------------------------------------------------------------------
# Companion Tools & External Directories
# ----------------------------------------------------------------------------
# External tools execute as independent processes with isolated credentials.
# Default locations assume standard sibling layout under C:\Projects\
AGENT_WORK_DIR=C:\Projects\AgentWork
TIKTOK_VIDEOS_DIR=C:\Projects\TiktokVideos
AGENT_GALLERY_DIR=C:\Projects\AgentGallery
IMAGEGEN_DIR=C:\Projects\ImageGen
SOCIALPOSTENGINE_DIR=C:\Projects\SocialPostEngine
VIBESTATS_DIR=C:\Projects\VibeStats
CONNECTORS_DIR=C:\Projects\Connectors

# ----------------------------------------------------------------------------
# Media, Vision & Offline Models
# ----------------------------------------------------------------------------
# Video scene: card_flip or treasure_chest (treasure_chest is production standard)
MEDIA_SCENE=treasure_chest
# Finished videos to keep (passed to TiktokVideos as MAX_SAVED_VIDEOS; default 50). A MAX_SAVED_VIDEOS line
# here did nothing: the agent never passed it on. Task thumbnails (data/task_thumbs, newest TASK_THUMBS_KEEP=200)
# outlive pruned videos.
VIDEO_KEEP_COUNT=50

# Optional: Decentralized AI Horde API key for priority image generation (/image)
# Anonymous key "0000000000" is used if left blank.
AI_HORDE_API_KEY=0000000000

# Local vision & offline models (Ollama running locally on port 11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_HOST: CloudLLM's local "ollama:" routes and the ollama engine. OLLAMA_URL: memory search and vision.
# OLLAMA_MODEL: the ollama engine's default model (OllamaClient in core/llm/ollama.py).
OLLAMA_MODEL=qwen2.5-coder:3b
VISION_MODEL=gemma3:4b
# Optional: CPU threads and context for the local "ollama:" routes (core/llm/ defaults 4 and 8192)
# OLLAMA_NUM_THREAD=4
# OLLAMA_NUM_CTX=8192
# Optional: the local memory-chores model and its mode (core/memory/; shadow | primary | off)
# MEMORY_LOCAL_MODEL=ollama:qwen3:4b-instruct
# Default off since 2026-10-10 (qwen3:4b lost the blind shadow test, IDEAS #10)
# MEMORY_LOCAL_MODE=off

# Optional binary paths (automatically discovered from PATH or default installs if omitted)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# AGY_PATH=

# ----------------------------------------------------------------------------
# Daemon & Upkeep Settings
# ----------------------------------------------------------------------------
# Heartbeat interval in seconds (default 30)
DAEMON_INTERVAL=30

# Tool routing toggle (1 = dynamic semantic + keyword routing, 0 = send all tools)
CHAT_TOOL_ROUTING=1

# ----------------------------------------------------------------------------
# Memory Backups
# ----------------------------------------------------------------------------
# Nightly snapshot of data/state.db taken into data/backups/ (also via DeskAI Backup button).
# Optional mirror copy directory, e.g. Google Drive for desktop virtual drive:
BACKUP_MIRROR_DIR=G:\My Drive\AlwaysOnAgent Backups
BACKUP_KEEP=14
# Local hour (0-23) of daily backup (3 = 03:00 AM)
BACKUP_HOUR=3

# ----------------------------------------------------------------------------
# External heartbeat (docs/IDEAS.md #1)
# ----------------------------------------------------------------------------
# A healthchecks.io-style ping URL. Every 5 minutes the agent pings it (or <url>/fail when DeskAI's API
# doesn't answer locally); the service emails/texts the owner when the pings stop. Empty = off. Keep it secret.
HEALTHCHECK_URL=

# ----------------------------------------------------------------------------
# Mini MCP server (scripts/mini_mcp.py): Hark's way in, published by Tailscale Funnel
# ----------------------------------------------------------------------------
# 32+ random characters, different from HUD_AUTH_TOKEN. Empty = the server refuses to start.
MINI_MCP_TOKEN=
MINI_MCP_PORT=8765
